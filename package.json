{
  "name": "dsh-douyin-browser-local",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "DSH 原生抖音工具与独立 DeepSeek 本地助手",
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "start": "node app.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "node --test verification/dsh-plugin.test.mjs verification/native-launch-command.test.mjs verification/native-settings.test.mjs tests/native-watch.test.mjs tests/native-spark.test.mjs tests/native-client.test.mjs",
    "test:browser": "node verification/browser-live.mjs"
  },
  "dependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/mcp": "0.0.83"
  },
  "exports": {
    ".": "./dsh-plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
